# CardioIA - Fase 5 | Modelo de configuracao do backend
# Copie este arquivo para ".env" e preencha os valores conforme necessario.
# O arquivo ".env" contem credenciais e NAO deve ser versionado.

# --- Modo de operacao do assistente -----------------------------------------
# auto   (padrao) tenta o Watson Assistant e recorre ao runtime local em falha
# watson exige o servico remoto; retorna HTTP 503 se indisponivel
# mock   usa exclusivamente o runtime local de dialogo
ASSISTANT_MODE=auto

# --- Credenciais do IBM Watson Assistant (obrigatorias no modo "watson") ----
WATSON_API_KEY=sua-chave-aqui
WATSON_SERVICE_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/seu-id-de-instancia
WATSON_ASSISTANT_ID=seu-assistant-id-aqui
WATSON_API_VERSION=2021-06-14

# --- Servidor Flask ----------------------------------------------------------
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# --- Log -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=*

# --- Persistencia e skill (opcional; usa caminhos padrao quando vazio) ------
DATABASE_PATH=
SKILL_FILE=
